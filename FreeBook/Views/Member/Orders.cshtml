@model MemberOrdersViewModel
@inject IStringLocalizer<ResourceWeb> Localizer

@await Html.PartialAsync("_FlashMessage")

<div class="container-custom py-5">
    <header class="text-center mb-5">
        <span class="available-books-eyebrow">
            <i class="fas fa-book-open" aria-hidden="true"></i>
            @Localizer["lbMemberArea"]
        </span>
        <h1 id="order-books-title">@Localizer["lbOrderBooks"]</h1>
        <p class="lead">@Localizer["lbOrderBooksDesc"]</p>
    </header>

    <section class="available-books" id="orderBooks" aria-labelledby="order-books-title">
        <h2 class="mb-4">@Localizer["lbAvailableBooks"]</h2>

        @if (Model.AvailableBooks.Count == 0)
        {
            <div class="available-books-empty" role="status">
                <i class="fas fa-book-open" aria-hidden="true"></i>
                <p>@Localizer["lbNoBooksAvailable"]</p>
            </div>
        }
        else
        {
            <div class="available-books-grid">
                @foreach (var book in Model.AvailableBooks)
                {
                    var coverUrl = string.IsNullOrWhiteSpace(book.ImageThumbnailUrl)
                        ? book.ImageUrl
                        : book.ImageThumbnailUrl;
                    <article class="available-book-card" data-book-id="@book.BookId">
                        <div class="available-book-cover">
                            @if (!string.IsNullOrWhiteSpace(coverUrl))
                            {
                                <img src="@coverUrl" alt="@Localizer["lbCoverImage"]" loading="lazy" />
                            }
                            else
                            {
                                <i class="fas fa-image available-book-placeholder" role="img"
                                   title="@Localizer["lbCoverImage"]" aria-label="@Localizer["lbCoverImage"]"></i>
                            }
                        </div>
                        <div class="available-book-body">
                            <h3 class="available-book-title">@book.Title</h3>
                            <dl class="available-book-meta">
                                <div>
                                    <dt>@Localizer["lbAuthor"]</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(book.AuthorName) ? "—" : book.AuthorName)</dd>
                                </div>
                                <div>
                                    <dt>@Localizer["lbCategory"]</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(book.CategoryName) ? "—" : book.CategoryName)</dd>
                                </div>
                            </dl>
                            <form asp-action="RequestBook" asp-controller="Member" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="BookId" value="@book.BookId" />
                                <button type="submit" class="btn btn-primary" id="orderBook_@book.BookId">
                                    <i class="fas fa-plus" aria-hidden="true"></i>
                                    @Localizer["lbOrderBook"]
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="mt-5" id="myRequests" aria-labelledby="my-requests-title">
        <h2 id="my-requests-title" class="mb-4">@Localizer["lbMyRequests"]</h2>

        @if (Model.Requests.Count == 0)
        {
            <div class="available-books-empty" role="status">
                <i class="fas fa-clipboard-list" aria-hidden="true"></i>
                <p>@Localizer["lbNoRequests"]</p>
            </div>
        }
        else
        {
            <table id="tableMyRequests" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbRequestedBook"]</th>
                        <th scope="col">@Localizer["lbRentalDate"]</th>
                        <th scope="col">@Localizer["lbStatus"]</th>
                        <th scope="col">@Localizer["lbActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.Requests)
                    {
                        <tr>
                            <td>@request.BookTitle</td>
                            <td>@request.CreatedOn.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (request.Status == RentalRequestStatusDto.Pending)
                                {
                                    <span class="badge badge-warning">@Localizer["lbPending"]</span>
                                }
                                else if (request.Status == RentalRequestStatusDto.Approved)
                                {
                                    <span class="badge badge-success">@Localizer["lbApproved"]</span>
                                }
                                else if (request.Status == RentalRequestStatusDto.Rejected)
                                {
                                    <span class="badge badge-danger">@Localizer["lbReject"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">@Localizer["lbCancelled"]</span>
                                }
                            </td>
                            <td>
                                @if (request.Status == RentalRequestStatusDto.Pending)
                                {
                                    <form asp-action="CancelRequest" asp-controller="Member" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="RequestId" value="@request.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" id="cancelRequest_@request.Id">
                                            @Localizer["lbCancelRequest"]
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span aria-hidden="true">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>
