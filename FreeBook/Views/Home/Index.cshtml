@inject IStringLocalizer<ResourceWeb> Localizer
@inject SignInManager<ApplicationUser> SignInManager
@using Microsoft.AspNetCore.Identity

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="display-4">@Localizer["lbWelcome"]</h1>
            <p class="lead text-muted">@Localizer["lbWelcomeDesc"]</p>
        </div>
    </div>

    @if (SignInManager.IsSignedIn(User))
    {
        <!-- Authenticated User Dashboard -->
        <div class="row g-3">
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-tachometer-alt fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">@Localizer["lbDashboard"]</h5>
                        <p class="card-text text-muted small">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="Categories" asp-action="Categories">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-tags fa-3x text-success mb-3"></i>
                        <h5 class="card-title">@Localizer["lbCategories"]</h5>
                        <p class="card-text text-muted small">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="Authors" asp-action="Authors">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-pen-fancy fa-3x text-info mb-3"></i>
                        <h5 class="card-title">@Localizer["lbAuthors"]</h5>
                        <p class="card-text text-muted small">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-muted h-100 border-0 shadow-sm" href="#" title="@Localizer["lbComingSoon"]">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-book fa-3x text-warning mb-3"></i>
                        <h5 class="card-title">@Localizer["lbManageBook"] <span class="badge bg-warning ms-1">@Localizer["lbComingSoon"]</span></h5>
                        <p class="card-text text-muted small">@Localizer["lbComingSoon"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="BookCopies" asp-action="BookCopies">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-copy fa-3x text-secondary mb-3"></i>
                        <h5 class="card-title">@Localizer["lbBookCopies"]</h5>
                        <p class="card-text text-muted small">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="Subscribers" asp-action="Subscribers">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-users fa-3x text-danger mb-3"></i>
                        <h5 class="card-title">@Localizer["lbSubscribers"]</h5>
                        <p class="card-text text-muted small">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="Rentals" asp-action="Rentals">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-book-reader fa-3x text-dark mb-3"></i>
                        <h5 class="card-title">@Localizer["lbRentals"]</h5>
                        <p class="card-text text-muted small">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-chart-bar fa-3x text-dark mb-3"></i>
                        <h5 class="card-title">@Localizer["lbReports"]</h5>
                        <p class="card-text text-muted small">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" href="/hangfire" target="_blank">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-tasks fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">@Localizer["lbHangfire"]</h5>
                        <p class="card-text text-muted small">Background Jobs</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" href="/swagger" target="_blank">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-code fa-3x text-success mb-3"></i>
                        <h5 class="card-title">@Localizer["lbSwagger"]</h5>
                        <p class="card-text text-muted small">API Documentation</p>
                    </div>
                </a>
            </div>
            <div class="col-md-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" href="/health">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-heartbeat fa-3x text-danger mb-3"></i>
                        <h5 class="card-title">@Localizer["lbHealth"]</h5>
                        <p class="card-text text-muted small">System Health Check</p>
                    </div>
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Public Landing -->
        <div class="row g-3 justify-content-center">
            <div class="col-md-6 col-lg-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" asp-area="Admin" asp-controller="Accounts" asp-action="Login">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-lock fa-4x text-primary mb-3"></i>
                        <h5 class="card-title">@Localizer["lbAdminLogin"]</h5>
                        <p class="card-text text-muted">@Localizer["lbPublicNotice"]</p>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-lg-4">
                <a class="card text-decoration-none text-dark h-100 border-0 shadow-sm hover-shadow" href="/health">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-heartbeat fa-4x text-danger mb-3"></i>
                        <h5 class="card-title">@Localizer["lbHealth"]</h5>
                        <p class="card-text text-muted">@Localizer["lbViewReport"]</p>
                    </div>
                </a>
            </div>
        </div>
        
        <div class="mt-5 text-center text-muted">
            <small>@Localizer["lbPublicNotice"]</small>
        </div>
    }
</div>

<style>
.hover-shadow:hover {
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    transform: translateY(-2px);
    transition: all 0.2s ease-in-out;
}
</style>