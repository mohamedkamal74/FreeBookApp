@model ErrorViewModel
@inject IStringLocalizer<ResourceWeb> Localizer

<section class="page-section" aria-labelledby="error-title">
    <div class="container-custom text-center py-5">
        <div class="error-code" aria-hidden="true">500</div>
        <header class="page-header">
            <h1 id="error-title">@Localizer["lbErrorTitle"]</h1>
            <p class="page-lead">@Localizer["lbErrorMessage"]</p>
        </header>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mb-4">
                <strong>@Localizer["lbErrorRequestId"]:</strong> <code>@Model.RequestId</code>
            </p>
        }
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@Localizer["lbHomePage"]</a>
    </div>
</section>
