@inject IStringLocalizer<ResourceWeb> Localizer
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.Name == "ar" ? "rtl" : "ltr")">
<head>
<title>Bookify | @Localizer["lbHomePage"]</title>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="description" content="@Localizer["lbWelcomeDesc"]">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Fonts: Inter (EN) + Cairo (AR) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
<!-- Bootstrap 4 -->
<link rel="stylesheet" type="text/css" href="~/web/styles/bootstrap4/bootstrap.min.css">
@if (CultureInfo.CurrentUICulture.Name == "ar")
{
    <link rel="stylesheet" type="text/css" href="~/web/styles/bootstrap4/bootstrap-rtl.min.css">
}
<!-- Font Awesome -->
<link href="~/web/plugins/fontawesome-free-5.0.1/css/fontawesome-all.css" rel="stylesheet" type="text/css">
<!-- Bookify Public Theme (loads last to override Bootstrap) -->
<link rel="stylesheet" type="text/css" href="~/web/styles/public-theme.css">
</head>
<body>

<a class="skip-link" href="#main-content">@Localizer["lbSkipToContent"]</a>

<div class="super_container">

    <!-- Header -->
    <header class="header">
        <div class="header-content">
            <!-- Logo -->
            <a href="@Url.Action("Index", "Home")" class="logo" aria-label="@Localizer["lbHomePage"]">
                <img src="~/web/images/logo.png" alt="" width="40" height="40">
                <span>Bookify</span>
            </a>

            <!-- Main Navigation -->
            <nav class="main-nav" id="main-nav" aria-label="@Localizer["lbMainNavigation"]">
                <ul class="main-nav-list">
                    <li class="main-nav-item"><a asp-controller="Home" asp-action="Index">@Localizer["lbHome"]</a></li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Localizer["lbDashboard"]</a></li>
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="Categories" asp-action="Categories">@Localizer["lbCategories"]</a></li>
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="Authors" asp-action="Authors">@Localizer["lbAuthors"]</a></li>
                        <li class="main-nav-item"><a href="#" class="text-muted" title="@Localizer["lbComingSoon"]">@Localizer["lbManageBook"] <span class="badge badge-warning">@Localizer["lbComingSoon"]</span></a></li>
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="BookCopies" asp-action="BookCopies">@Localizer["lbBookCopies"]</a></li>
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="Subscribers" asp-action="Subscribers">@Localizer["lbSubscribers"]</a></li>
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="Rentals" asp-action="Rentals">@Localizer["lbRentals"]</a></li>
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="Reports" asp-action="Index">@Localizer["lbReports"]</a></li>
                    }
                    else
                    {
                        <li class="main-nav-item"><a asp-area="Admin" asp-controller="Accounts" asp-action="Login">@Localizer["lbAdminLogin"]</a></li>
                    }

                    <li class="main-nav-item"><a href="/hangfire" target="_blank" rel="noopener">@Localizer["lbHangfire"]</a></li>
                    <li class="main-nav-item"><a href="/swagger" target="_blank" rel="noopener">@Localizer["lbSwagger"]</a></li>
                    <li class="main-nav-item"><a href="/health">@Localizer["lbHealth"]</a></li>
                </ul>
            </nav>
        </div>

        <div class="header-side">
            @await Html.PartialAsync("_LanguageSwitcher")
            <div class="header-contact">
                <img src="~/web/images/phone-call.svg" alt="" width="20" height="20">
                <span>+43 4566 7788 2457</span>
            </div>

            <!-- Hamburger -->
            <button class="hamburger" type="button" aria-label="@Localizer["lbToggleMenu"]" aria-expanded="false" aria-controls="main-nav">
                <i class="fas fa-bars"></i>
            </button>
        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

	    <!-- Footer -->
    <footer class="footer" role="contentinfo">
        <div class="footer-grid container-custom">
            <!-- Footer Column - About -->
            <div class="footer-brand">
                <a href="@Url.Action("Index", "Home")" class="footer-logo" aria-label="@Localizer["lbHomePage"]">
                    <img src="~/web/images/logo.png" alt="" width="40" height="40">
                    <span>Bookify</span>
                </a>
                <p class="footer-tagline">@Localizer["lbWelcomeDesc"]</p>
                
                <div class="footer-social">
                    <a href="#" aria-label="Pinterest"><i class="fab fa-pinterest"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                </div>
            </div>

            <!-- Footer Column - Menu -->
            <div class="footer-column">
                <h3 class="footer-column-title">@Localizer["lbCategories"]</h3>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">@Localizer["lbHome"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Accounts" asp-action="Login">@Localizer["lbAdminLogin"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Categories" asp-action="Categories">@Localizer["lbCategories"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Authors" asp-action="Authors">@Localizer["lbAuthors"]</a></li>
                    <li><a href="/hangfire" target="_blank" rel="noopener">@Localizer["lbHangfire"]</a></li>
                    <li><a href="/swagger" target="_blank" rel="noopener">@Localizer["lbSwagger"]</a></li>
                    <li><a href="/health">@Localizer["lbHealth"]</a></li>
                </ul>
            </div>

            <!-- Footer Column - Reports -->
            <div class="footer-column">
                <h3 class="footer-column-title">@Localizer["lbReports"]</h3>
                <ul class="footer-links">
                    <li><a asp-area="Admin" asp-controller="Reports" asp-action="OverdueBooks">@Localizer["lbViewOverdueBooks"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Reports" asp-action="PopularBooks">@Localizer["lbViewPopularBooks"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Reports" asp-action="ActiveSubscribers">@Localizer["lbViewActiveSubscribers"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Reports" asp-action="ExpiringSubscriptions">@Localizer["lbViewExpiringSubscriptions"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Reports" asp-action="RentalHistory">@Localizer["lbViewRentalHistory"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Reports" asp-action="BooksByCategory">@Localizer["lbViewBooksByCategory"]</a></li>
                    <li><a asp-area="Admin" asp-controller="Reports" asp-action="BooksByAuthor">@Localizer["lbViewBooksByAuthor"]</a></li>
                </ul>
            </div>

            <!-- Footer Column - Contact -->
            <div class="footer-column">
                <h3 class="footer-column-title">@Localizer["lbContactUs"]</h3>
                <ul class="footer-contact">
                    <li class="footer-contact-item">
                        <span class="footer-contact-icon"><i class="fas fa-map-marker-alt"></i></span>
                        <span>Blvd Libertad, 34 05200 Arévalo</span>
                    </li>
                    <li class="footer-contact-item">
                        <span class="footer-contact-icon"><i class="fas fa-phone"></i></span>
                        <span>+43 4566 7788 2457</span>
                    </li>
                    <li class="footer-contact-item">
                        <span class="footer-contact-icon"><i class="fas fa-envelope"></i></span>
                        <span>hello@bookify.local</span>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom container-custom">
            <div class="footer-legal">
                <span>&copy; <span data-year>@DateTime.Now.Year</span> @Localizer["lbFooter"]</span>
            </div>
            <div class="footer-social">
                <a href="#" aria-label="Pinterest"><i class="fab fa-pinterest"></i></a>
                <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
            </div>
        </div>
    </footer>

</div>

<script src="~/web/js/jquery-3.2.1.min.js"></script>
<script src="~/web/styles/bootstrap4/popper.js"></script>
<script src="~/web/styles/bootstrap4/bootstrap.min.js"></script>
<script>
    document.querySelectorAll('[data-year]').forEach(function (el) {
        el.textContent = new Date().getFullYear();
    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>


