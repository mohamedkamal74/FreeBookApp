@model ErrorViewModel
@inject IStringLocalizer<ResourceWeb> Localizer

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card card-outline card-danger shadow-sm">
            <div class="card-body text-center py-5">
                <div class="error-code" aria-hidden="true">500</div>
                <h1 class="h4 mt-3 mb-3">@Localizer["lbErrorTitle"]</h1>
                <p class="text-muted mb-4">@Localizer["lbErrorMessage"]</p>
                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        <strong>@Localizer["lbErrorRequestId"]:</strong> <code>@Model.RequestId</code>
                    </p>
                }
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-home" aria-hidden="true"></i>
                    @Localizer["lbGoToDashboard"]
                </a>
            </div>
        </div>
    </div>
</div>
