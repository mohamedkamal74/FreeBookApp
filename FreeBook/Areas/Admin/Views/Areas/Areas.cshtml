@model AreaViewModel
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "Areas";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbAreas"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Dashboard/Index"> @Localizer["lbHomePage"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbManageBook"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-start">
            <h3 class="card-title">@Localizer["lbAreas"]</h3>
        </div>
        <div class="card-tools">
            <button type="button" class="btn btn-outline-primary rounded-pill mr-5 mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                @Localizer["lbBtnSaveNewArea"]
            </button>
        </div>
        <div class="card-body">
            <table id="tableAreas" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbAreaName"]</th>
                        <th scope="col">@Localizer["lbGovernorate"]</th>
                        <th scope="col">@Localizer["lbEvents"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Areas)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Governorate?.Name</td>
                            <td>
                                <input type="button" class="btn btn-info btn-sm" onclick="Edit('@item.Id','@Js.Encode(item.Name)','@item.GovernorateId')" value="@Localizer["lbBtnEdit"]" data-bs-toggle="modal" data-bs-target="#exampleModal" />
                                <input type="button" class="btn btn-danger btn-sm" onclick="DeleteArea('@item.Id')" value="@Localizer["lbbtnDelete"]" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <modal id="exampleModal" title-id="areaModalTitle" title="@Localizer["lbBtnSaveNewArea"]">
        <form asp-action="Save" asp-controller="Areas" method="post">
            <div class="form-group">
                <input type="text" asp-for="NewArea.AreaId" hidden class="form-control" id="areaId"/>
                <div class="form-group">
                    <label class="control-label" asp-for="NewArea.Name">@Localizer["lbAreaName"]</label>
                    <input type="text" asp-for="NewArea.Name" class="form-control" id="areaName"/>
                    <span asp-validation-for="NewArea.Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="control-label" asp-for="NewArea.GovernorateId">@Localizer["lbGovernorate"]</label>
                    <select asp-for="NewArea.GovernorateId" class="form-control" id="governorateId"
                            asp-items="@(new SelectList(Model.Governorates,"Id","Name"))">
                        <option value="">@Localizer["lbSelectUserRole"]</option>
                    </select>
                    <span asp-validation-for="NewArea.GovernorateId" class="text-danger"></span>
                </div>
                <input type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="areaModalBtnSave"/>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["lbClose"]</button>
        </form>
    </modal>

    <form id="deleteForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" id="deleteFormId" />
    </form>

    @section Script{
        @if(!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
        {
            if(Context.Session.GetString(Helper.MsgType)==Helper.Success)
            {
                <script>
                Swal.fire({
                    icon: 'success',
                    title:'@Context.Session.GetString(Helper.Title)',
                    text:' @Html.Raw(Context.Session.GetString(Helper.Msg))',
                    confirmButtonText:'@Localizer["lbOk"]'
                })
                </script>
            }
            else{
                <script>
                    Swal.fire({
                        icon: 'error',
                        title: '@Context.Session.GetString(Helper.Title)',
                        text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
                        confirmButtonText:'@Localizer["lbOk"]'
                    })
                </script>
            }
            Context.Session.SetString("msgType","");
        }

        <script src="~/Models/Areas.js"></script>

        <script>
            let lbTitleEditArea='@Html.Raw(Localizer["lbTitleEditArea"])';
            let lbEdit='@Html.Raw(Localizer["lbEdit"])';
            let lbBtnSaveNewArea='@Html.Raw(Localizer["lbBtnSaveNewArea"])';
            let lbBtnSave='@Html.Raw(Localizer["lbBtnSave"])';
            let lbTitleDeleteMsg='@Html.Raw(Localizer["lbTitleDeleteMsg"])';
            let lmTextMsgDelete='@Html.Raw(Localizer["lmTextMsgDelete"])';
            let lbconfirmButtonText='@Html.Raw(Localizer["lbconfirmButtonText"])';
            let lbCancelButtonText='@Html.Raw(Localizer["lbCancelButtonText"])';
        
    // DataTables language strings (localized via ResourceWeb)
    let dtSearch      = '@Html.Raw(Localizer["dtSearch"])';
    let dtLengthMenu  = '@Html.Raw(Localizer["dtLengthMenu"])';
    let dtInfo        = '@Html.Raw(Localizer["dtInfo"])';
    let dtInfoEmpty   = '@Html.Raw(Localizer["dtInfoEmpty"])';
    let dtInfoFiltered= '@Html.Raw(Localizer["dtInfoFiltered"])';
    let dtZeroRecords = '@Html.Raw(Localizer["dtZeroRecords"])';
    let dtEmptyTable  = '@Html.Raw(Localizer["dtEmptyTable"])';
    let dtLoadingRecords = '@Html.Raw(Localizer["dtLoadingRecords"])';
    let dtProcessing  = '@Html.Raw(Localizer["dtProcessing"])';
    let dtPaginateFirst    = '@Html.Raw(Localizer["dtPaginateFirst"])';
    let dtPaginatePrevious = '@Html.Raw(Localizer["dtPaginatePrevious"])';
    let dtPaginateNext     = '@Html.Raw(Localizer["dtPaginateNext"])';
    let dtPaginateLast     = '@Html.Raw(Localizer["dtPaginateLast"])';
    let dtAriaSortAscending = '@Html.Raw(Localizer["dtAriaSortAscending"])';
    let dtAriaSortDescending = '@Html.Raw(Localizer["dtAriaSortDescending"])';
    initDataTablesLanguage();</script>
    }