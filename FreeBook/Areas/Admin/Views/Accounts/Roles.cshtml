@model RolesViewModel
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "Roles";
}

<div class="content-wrapper">
    <!--Content Header-->

<div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
          <h1 class="m-0 text-dark">@Localizer["lbRoleUser"] </h1>
          </div>
          <div class="col-sm-6">
            <ol class=" breadcrumb float-sm-right">
<li class="breadcrumb-item"><a href="/Admin/Home/Index"> @Localizer["lbHomePage"]</a></li>
<li class="breadcrumb-item active">@Localizer["lbManageBook"]</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
<!--End content Header-->
<div class="card">
            <div class="card-header d-flex align-items-center justify-content-start">
              <h3 class="card-title">@Localizer["lbRoleUser"]</h3>
            </div>
            <div class="card-tools">
                <!-- Button trigger modal -->

<button type="button" class="btn btn-outline-primary rounded-pill mr-5 mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
@Localizer["lbBtnSaveNewRole"]
</button>
 <!-- Button trigger modal -->
            </div>
            <!-- /.card-header -->
            <div class="card-body">
              <table id="tableRoles" class="table table-bordered table-hover table-striped">
<thead>
    <tr>
        <td>@Localizer["lbNameRole"]</td>
        <td>@Localizer["lbEvents"]</td>
    </tr>
</thead>
                <tbody>
                @foreach (var item in Model.Roles)
                                {
                                    <tr>
                                          <td>
                                            @switch (@item.Name)
                                            {
                                                    case "SupperAdmin":
                                                    <span class="badge badge-danger" style="width:300px;height:25px">@item.Name</span>
                                                    break;
                                                    case "Admin":
                                                    <span class="badge badge-success" style="width:300px;height:25px">@item.Name</span>
                                                    break;
                                                    default:
                                                    <span class="badge badge-warning" style="width:300px;height:25px">@item.Name</span>
                                                    break;
                                            }
                                        </td>                                      
<td>
    <input type="button" class="btn btn-info btn-sm" onclick="Edit('@item.Id','@item.Name')" value="@Localizer["lbBtnEdit"]" data-bs-toggle="modal" data-bs-target="#exampleModal" />
    <input type="button" class="btn btn-danger btn-sm" onclick="DeleteRoles('@item.Id')" value="@Localizer["lbbtnDelete"]"/>
</td>
                    </tr>

                }

                </tbody>

              </table>
            <!-- /.card-body -->
          </div>
</div>





<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="roleModalTitle">@Localizer["lbBtnSaveNewRole"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

       <form asp-action="Roles" asp-controller="Accounts" method="post">
            <div class="form-group">
           <input type="text" asp-for="NewRole.RoleId" hidden class="form-control" id="roleId"/>

<label class="control-label" asp-for="NewRole.RoleName">@Localizer["lbNameRole"]</label>
<input type="text" asp-for="NewRole.RoleName" class="form-control" id="roleName"/>
<span asp-validation-for="NewRole.RoleName" class="text-danger"></span>
</div>
<input  type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="roleModalBtnSave"/>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

       </form>
      </div>
      <div class="modal-footer">

      </div>
    </div>
  </div>
</div>

<form id="deleteForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" id="deleteFormId" />
</form>

@section Script{
@if(!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
{
    if(Context.Session.GetString(Helper.MsgType)==Helper.Success)
    {
        <script>
        Swal.fire({

  icon: 'success',
  title:'@Context.Session.GetString(Helper.Title)',
  text:' @Html.Raw(Context.Session.GetString(Helper.Msg))',
confirmButtonText:'@Localizer["lbOk"]'



})
        </script>
    }
    else{
        <script>
            Swal.fire({
  icon: 'error',
  title: '@Context.Session.GetString(Helper.Title)',
  text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
  confirmButtonText:'@Localizer["lbOk"]'



})
        </script>
    }
Context.Session.SetString("msgType","");
}

<script src="~/Models/Roles.js"></script>

<script>

     let lbTitleEdit='@Html.Raw(Localizer["lbTitleEdit"])';
     let lbEdit='@Html.Raw(Localizer["lbEdit"])';
     let lbEditNewRole='@Html.Raw(Localizer["lbEditNewRole"])';
     let lbSave='@Html.Raw(Localizer["lbSave"])';


</script>


}