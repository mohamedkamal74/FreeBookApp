@model RegisterViewModel
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "Register";
}


<div class="content-wrapper">
    <!--Content Header-->

<div class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
          <h1 class="m-0 text-dark">@Localizer["lbUser"] </h1>
          </div>
          <div class="col-sm-6">
            <ol class=" breadcrumb float-sm-right">
<li class="breadcrumb-item"><a href="/Admin/Home/Index"> @Localizer["lbHomePage"]</a></li>
<li class="breadcrumb-item active">@Localizer["lbManageBook"]</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
<!--End content Header-->
<div class="card">
            <div class="card-header d-flex align-items-center justify-content-start">
              <h3 class="card-title">@Localizer["lbUser"]</h3>
            </div>
            <div class="card-tools">
                <!-- Button trigger modal -->

<button type="button" class="btn btn-outline-primary rounded-pill mr-5 mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
@Localizer["lbBtnSaveNewUser"]
</button>
 <!-- Button trigger modal -->
            </div>
            <!-- /.card-header -->
            <div class="card-body">
              <table id="tableRoles" class="table table-bordered table-hover table-striped">
<thead>
    <tr>
        <td style="width:15%">@Localizer["lbNameUser"]</td>
        <td style="width:15%">@Localizer["lbNameRole"]</td>
        <td style="width:15%">@Localizer["lbImageUser"]</td>
        <td style="width:15%">@Localizer["lbEmailUser"]</td>
        <td style="width:10%">@Localizer["lbActiveUser"]</td>
        <td style="width:30%">@Localizer["lbEvents"]</td>
    </tr>
</thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td>
                                            @switch (@user.Role)
                                            {
                                                    case "SupperAdmin":
                                                    <span class="badge badge-danger" style="width:100px;height:25px">@user.Role</span>
                                                    break;
                                                    case "Admin":
                                                    <span class="badge badge-success" style="width:100px;height:25px">@user.Role</span>
                                                    break;
                                                    default:
                                                    <span class="badge badge-warning" style="width:100px;height:25px">@user.Role</span>
                                                    break;
                                            }
                                        </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(user.ImageUser))
                                {
                                    <img src="@Helper.PathImageUser/@user.ImageUser" class="img-bordered img-circle" style="width:50px;height:50px" />
                                }
                            </td>
                            <td>@user.Email</td>
                        <td><input type="checkbox" disabled checked="@user.ActiveUser" style="width:30px;height:30px"/></td>
<td>
    <input type="button" class="btn btn-info btn-sm" onclick="Edit('@user.Id','@user.Name','@user.Email','@user.ImageUser','@user.Role','@user.ActiveUser')"
    value="@Localizer["lbBtnEdit"]" data-bs-toggle="modal" data-bs-target="#exampleModal" />
    <input type="button" class="btn btn-danger btn-sm" onclick="DeleteUser('@user.Id')" value="@Localizer["lbbtnDelete"]"/>
    <input type="button" class="btn btn-dark btn-sm" onclick="ChangePassword('@user.Id')" value="@Localizer["lbbtnChangePassword"]"
    data-bs-toggle="modal" data-bs-target="#ChangePasswordModal"/>
</td>

                        </tr>

                    }

               

                </tbody>

              </table>
            <!-- /.card-body -->
          </div>
</div>




<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="userModalTitle">@Localizer["lbBtnSaveNewUser"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

       <form asp-action="Register" asp-controller="Accounts" method="post" enctype="multipart/form-data">
            <div class="form-group">
           <input type="text" asp-for="NewRegister.Id" hidden class="form-control" id="userId"/>
           <input type="text" asp-for="NewRegister.ImageUser" hidden class="form-control" id="imagehidden"/>

            <label class="control-label" asp-for="NewRegister.Name">@Localizer["lbNameUser"]</label>
            <input type="text" asp-for="NewRegister.Name" class="form-control" id="userName"/>
            <span asp-validation-for="NewRegister.Name" class="text-danger"></span>
            </div>
             <div class="form-group">
            <label class="control-label" asp-for="NewRegister.Email">@Localizer["lbEmailUser"]</label>
            <input type="text" asp-for="NewRegister.Email" class="form-control" id="userEmail"/>
            <span asp-validation-for="NewRegister.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <!-- src is set by Register.js (Edit); no request is made when it is empty. -->
                <img class="img-circle" style="width:35px;height:35px" hidden id="image" alt="" />
            </div>
             <div class="form-group">
            <label class="control-label" asp-for="NewRegister.ImageUser">@Localizer["lbImageUser"]</label>
            <input type="file" asp-for="NewRegister.ImageUser" class="form-control" id="userImage"/>
            <span asp-validation-for="NewRegister.ImageUser" class="text-danger"></span>
            </div>
             <div class="form-group">
<label class="control-label" asp-for="NewRegister.RoleName">@Localizer["lbNameRole"]</label>
<select asp-for="NewRegister.RoleName" class="form-control" id="ddluserRole"
asp-items="@(new SelectList(Model.Roles,"Name","Name"))">
    <option value="">@Localizer["lbSelectUserRole"]</option>
</select>
            <span asp-validation-for="NewRegister.RoleName" class="text-danger"></span>
            </div>
             <div class="form-group">
            <label class="control-label" asp-for="NewRegister.ActiveUser">@Localizer["lbActiveUser"]</label>
            <input type="checkbox"  asp-for="NewRegister.ActiveUser" style="height:30px;width:30px" id="userActive"/>


            </div>
              <div class="form-group" id="grPassword">
            <label class="control-label" asp-for="NewRegister.Password">@Localizer["lbPassword"]</label>
            <input type="password" asp-for="NewRegister.Password" class="form-control" id="userPassword"/>
            <span asp-validation-for="NewRegister.Password" class="text-danger"></span>
            </div>
<div class="form-group" id="confPassword">
             <label class="control-label" asp-for="NewRegister.ConfirmPassword">@Localizer["lbConfirmpassword"]</label>
             <input type="password" asp-for="NewRegister.ConfirmPassword" class="form-control" id="userConfirm"/>
             <span asp-validation-for="NewRegister.ConfirmPassword" class="text-danger"></span>
             </div>
              <input  type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="userModalBtnSave"/>
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

        </form>
      </div>
      <div class="modal-footer">

      </div>
    </div>
  </div>
</div>


<!--Modal Change Password-->

<div class="modal fade" id="ChangePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="changePasswordModalTitle">@Localizer["lbbtnChangePassword"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">

       <form asp-action="ChangePassword" asp-controller="Accounts" method="post" enctype="multipart/form-data">
            <div class="form-group">
           <input type="text" asp-for="changePassword.Id" hidden class="form-control" id="userPassId"/>

            <label class="control-label" asp-for="changePassword.NewPassword">@Localizer["lbPassword"]</label>
            <input type="password" asp-for="changePassword.NewPassword" class="form-control" />
            <span asp-validation-for="changePassword.NewPassword" class="text-danger"></span>
            </div>
<div class="form-group">
             <label class="control-label" asp-for="changePassword.ConfirmPassword">@Localizer["lbConfirmpassword"]</label>
             <input type="password" asp-for="changePassword.ConfirmPassword" class="form-control" />
             <span asp-validation-for="changePassword.ConfirmPassword" class="text-danger"></span>
             </div>

              
              <input  type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="changePasswordModalBtnSave"/>
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>

        </form>
      </div>
      <div class="modal-footer">

      </div>
    </div>
  </div>
</div>
</div>

<form id="deleteForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="userId" id="deleteFormUserId" />
</form>

@section Script{
@if(!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
{
    if(Context.Session.GetString("msgType")==Helper.Success)
    {
        <script>
        Swal.fire({

  icon: 'success',
  title:'@Context.Session.GetString(Helper.Title)',
  text:' @Html.Raw(Context.Session.GetString(Helper.Msg))',
confirmButtonText:'@Localizer["lbOk"]'

  
})
        </script>
    }
    else{
        <script>
            Swal.fire({
  icon: 'error',
  title: '@Context.Session.GetString(Helper.Title)',
  text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
  confirmButtonText:'@ResourceWeb.lbOk'

})
        </script>
    }
Context.Session.SetString(Helper.MsgType,"");
}

<script src="~/Models/Register.js"></script>

<script>

    let lbTitleEdit='@Html.Raw(Localizer["lbTitleEdit"])';
    let lbUpdate='@Html.Raw(Localizer["lbUpdate"])';
    let lbBtnSaveNewRole='@Html.Raw(Localizer["lbBtnSaveNewRole"])';
    let lbBtnSaveNewUser='@Html.Raw(Localizer["lbBtnSaveNewUser"])';
    let lbBtnSave='@Html.Raw(Localizer["lbBtnSave"])';
    let lbTitleDeleteMsg='@Html.Raw(Localizer["lbTitleDeleteMsg"])';
    let lmTextMsgDelete='@Html.Raw(Localizer["lmTextMsgDelete"])';
    let lbconfirmButtonText='@Html.Raw(Localizer["lbconfirmButtonText"])';
    let lbCancelButtonText='@Html.Raw(Localizer["lbCancelButtonText"])';

    let lbTitleDeletedOk='@Html.Raw(Localizer["lbTitleDeletedOk"])';
    let lbSuccess='@Html.Raw(Helper.Success)';
    let lbPathImageUser='@Html.Raw(Helper.PathImageUser)';


</script>

}