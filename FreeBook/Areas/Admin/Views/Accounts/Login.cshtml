@model LoginViewModel
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.Name == "ar" ? "rtl" : "ltr")">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>@Localizer["lbAppTitle"] | @Localizer["lbLogin"]</title>
  <!-- Tell the browser to be responsive to screen width -->
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="~/Admin/plugins/fontawesome-free/css/all.min.css">
  <!-- icheck bootstrap -->
  <link rel="stylesheet" href="~/Admin/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="~/Admin/dist/css/adminlte.min.css">
  @if (CultureInfo.CurrentUICulture.Name == "ar")
  {
      <link rel="stylesheet" href="~/Admin/dist/css/bootstrap-rtl.min.css">
      <!-- Arabic font: Cairo -->
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
  }
  <!-- Bookify Theme -->
  <link rel="stylesheet" href="~/Admin/dist/css/theme.css">
</head>
<body class="hold-transition login-page">
<div class="login-box">
  <div class="login-logo">
    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
      <span class="text-white">@Localizer["lbAppTitle"]</span>
    </a>
  </div>
  <!-- /.login-logo -->
  <div class="card card-login">
    <div class="card-body login-card-body">
      <p class="login-box-msg">@Localizer["lbLoginSubtitle"]</p>

<form asp-action="Login" asp-controller="Accounts" method="post">
        @if(ViewBag.ErrorLogin==false)
        {<span class="alert alert-danger w-100">@Localizer["lbMsgErrorLogin"]</span><br /><br />}
        <div class="input-group mb-3">
          <input type="email" class="form-control" asp-for="Email" placeholder="@Localizer["lbEmailPlaceholder"]">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-envelope"></span>
            </div>
          </div>
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
        <div class="input-group mb-3">
          <input type="password" class="form-control" asp-for="Password" placeholder="@Localizer["lbPasswordPlaceholder"]">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-lock"></span>
            </div>
          </div>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>

        <div class="row">
          <div class="col-8">
            <div class="icheck-primary">
              <input type="checkbox" asp-for="RememberMe" id="remember">
              <label for="remember">
                @Localizer["lbRememberMe"]
              </label>
            </div>
          </div>
          <!-- /.col -->
          <div class="col-4">
            <button type="submit" class="btn btn-primary btn-block">@Localizer["lbBtnSignIn"]</button>
          </div>
          <!-- /.col -->
        </div>
      </form>

      @await Html.PartialAsync("_LanguageSwitcher")

      <div class="social-auth-links text-center mb-3">
        <p>- OR -</p>
        <a href="#" class="btn btn-block btn-primary">
          <i class="fab fa-facebook mr-2"></i> @Localizer["lbLoginWithFacebook"]
        </a>
        <a href="#" class="btn btn-block btn-danger">
          <i class="fab fa-google mr-2"></i> @Localizer["lbLoginWithGoogle"]
        </a>
      </div>
      <!-- /.social-auth-links -->

      <p class="mb-1">
        <a href="#">@Localizer["lbForgotPassword"]</a>
      </p>
      <p class="mb-0">
        <a href="#" class="text-center">@Localizer["lbRegisterNewMembership"]</a>
      </p>
    </div>
    <!-- /.login-card-body -->
  </div>
</div>
<!-- /.login-box -->

<!-- jQuery -->
<script src="~/Admin/plugins/jquery/jquery.min.js"></script>
<!-- Bootstrap 4 -->
<script src="~/Admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

</body>
</html>