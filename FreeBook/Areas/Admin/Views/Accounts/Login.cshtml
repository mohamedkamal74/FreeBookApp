@model LoginViewModel
@inject IStringLocalizer<ResourceWeb> Localizer
@inject IOptions<GoogleAuthSettings> GoogleAuth
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.Name == "ar" ? "rtl" : "ltr")">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>@Localizer["lbAppTitle"] | @Localizer["lbLogin"]</title>
  <!-- Tell the browser to be responsive to screen width -->
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="~/Admin/plugins/fontawesome-free/css/all.min.css">
  <!-- icheck bootstrap -->
  <link rel="stylesheet" href="~/Admin/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="~/Admin/dist/css/adminlte.min.css">
  @if (CultureInfo.CurrentUICulture.Name == "ar")
  {
      <link rel="stylesheet" href="~/Admin/dist/css/bootstrap-rtl.min.css">
      <!-- Arabic font: Cairo -->
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&display=swap" rel="stylesheet">
  }
  <!-- Bookify Theme -->
  <link rel="stylesheet" href="~/Admin/dist/css/theme.css">
</head>
<body class="hold-transition login-page">
<div class="login-box">
  <div class="login-logo">
    <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
      <span class="text-white">@Localizer["lbAppTitle"]</span>
    </a>
  </div>
  <!-- /.login-logo -->
  <div class="card card-login">
    <div class="card-body login-card-body">
      <p class="login-box-msg">@Localizer["lbLoginSubtitle"]</p>

<form asp-action="Login" asp-controller="Accounts" method="post">
        @if(ViewBag.ErrorLogin==false)
        {<span class="alert alert-danger w-100">@Localizer["lbMsgErrorLogin"]</span><br /><br />}
        <div class="input-group mb-3">
          <input type="email" class="form-control" asp-for="Email" placeholder="@Localizer["lbEmailPlaceholder"]">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-envelope"></span>
            </div>
          </div>
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
        <div class="input-group mb-3">
          <input type="password" class="form-control" asp-for="Password" placeholder="@Localizer["lbPasswordPlaceholder"]">
          <div class="input-group-append">
            <div class="input-group-text">
              <span class="fas fa-lock"></span>
            </div>
          </div>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>

        <div class="row">
          <div class="col-8">
            <div class="icheck-primary">
              <input type="checkbox" asp-for="RememberMe" id="remember">
              <label for="remember">
                @Localizer["lbRememberMe"]
              </label>
            </div>
          </div>
          <!-- /.col -->
          <div class="col-4">
            <button type="submit" class="btn btn-primary btn-block">@Localizer["lbBtnSignIn"]</button>
          </div>
          <!-- /.col -->
        </div>
      </form>

      @await Html.PartialAsync("_LanguageSwitcher")

      <div class="social-auth-links text-center mb-3">
        <p>- OR -</p>
        @if (GoogleAuth.Value.Enabled)
        {
          <a id="googleLogin" asp-action="ExternalLogin" asp-controller="Accounts" class="btn btn-block btn-google-auth">
            <span class="google-icon mr-2" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="18" height="18" focusable="false">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
              </svg>
            </span>
            @Localizer["lbLoginWithGoogle"]
          </a>
        }
      </div>
      <!-- /.social-auth-links -->

      <p class="mb-1">
        <a href="#">@Localizer["lbForgotPassword"]</a>
      </p>
      <p class="mb-0">
        <a href="#" class="text-center">@Localizer["lbRegisterNewMembership"]</a>
      </p>
    </div>
    <!-- /.login-card-body -->
  </div>
</div>
<!-- /.login-box -->

<!-- jQuery -->
<script src="~/Admin/plugins/jquery/jquery.min.js"></script>
<!-- Bootstrap 4 -->
<script src="~/Admin/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

</body>
</html>