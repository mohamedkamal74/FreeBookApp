@model BookCopyViewModel
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "BookCopies";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbBookCopies"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home/Index"> @Localizer["lbHomePage"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbManageBook"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-start">
            <h3 class="card-title">@Localizer["lbBookCopies"]</h3>
        </div>
        <div class="card-tools">
            <button type="button" class="btn btn-outline-primary rounded-pill mr-5 mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                @Localizer["lbBtnSaveNewCategory"]
            </button>
        </div>
        <div class="card-body">
            <table id="tableBookCopies" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <td>@Localizer["lbBookName"]</td>
                        <td>@Localizer["lbEditionNumber"]</td>
                        <td>@Localizer["lbSerialNumber"]</td>
                        <td>@Localizer["lbActiveUser"]</td>
                        <td>@Localizer["lbEvents"]</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BookCopies)
                    {
                        <tr>
                            <td>@item.Book?.Name</td>
                            <td>@item.EditionNumber</td>
                            <td>@item.SerialNumber</td>
                            <td>
                                <input type="checkbox" disabled checked="@item.IsAvailableForRental" style="width:30px;height:30px"/>
                            </td>
                            <td>
                                <input type="button" class="btn btn-info btn-sm" onclick="Edit('@item.Id','@item.BookId','@item.EditionNumber','@item.SerialNumber','@item.IsAvailableForRental')" value="@Localizer["lbBtnEdit"]" data-bs-toggle="modal" data-bs-target="#exampleModal" />
                                <input type="button" class="btn btn-danger btn-sm" onclick="DeleteBookCopy('@item.Id')" value="@Localizer["lbbtnDelete"]" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="title">@Localizer["lbBtnSaveNewCategory"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="Save" asp-controller="BookCopies" method="post">
                        <div class="form-group">
                            <input type="text" asp-for="NewBookCopy.BookCopyId" hidden class="form-control" id="bookCopyId"/>
                            <div class="form-group">
                                <label class="control-label" asp-for="NewBookCopy.BookId">@Localizer["lbBookName"]</label>
                                <select asp-for="NewBookCopy.BookId" class="form-control" id="bookId"
                                        asp-items="@(new SelectList(Model.Books,"Id","Name"))">
                                    <option value="">@Localizer["lbSelectUserRole"]</option>
                                </select>
                                <span asp-validation-for="NewBookCopy.BookId" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label class="control-label" asp-for="NewBookCopy.EditionNumber">@Localizer["lbEditionNumber"]</label>
                                <input type="number" asp-for="NewBookCopy.EditionNumber" class="form-control" id="editionNumber" min="1"/>
                                <span asp-validation-for="NewBookCopy.EditionNumber" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label class="control-label" asp-for="NewBookCopy.SerialNumber">@Localizer["lbSerialNumber"]</label>
                                <input type="number" asp-for="NewBookCopy.SerialNumber" class="form-control" id="serialNumber" min="1"/>
                                <span asp-validation-for="NewBookCopy.SerialNumber" class="text-danger"></span>
                            </div>
                            <div class="form-check mt-2">
                                <input type="checkbox" asp-for="NewBookCopy.IsAvailableForRental" class="form-check-input" id="isAvailable"/>
                                <label class="form-check-label" for="isAvailable">@Localizer["lbActiveUser"]</label>
                            </div>
                            <input type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="btnSave"/>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>

    <form id="deleteForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" id="deleteFormId" />
    </form>

    @section Script{
        @if(!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
        {
            if(Context.Session.GetString(Helper.MsgType)==Helper.Success)
            {
                <script>
                Swal.fire({
                    icon: 'success',
                    title:'@Context.Session.GetString(Helper.Title)',
                    text:' @Html.Raw(Context.Session.GetString(Helper.Msg))',
                    confirmButtonText:'@Localizer["lbOk"]'
                })
                </script>
            }
            else{
                <script>
                    Swal.fire({
                        icon: 'error',
                        title: '@Context.Session.GetString(Helper.Title)',
                        text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
                        confirmButtonText:'@Localizer["lbOk"]'
                    })
                </script>
            }
            Context.Session.SetString("msgType","");
        }

        <script src="~/Models/BookCopies.js"></script>

        <script>
            let lbTitleEdit='@Html.Raw(Localizer["lbTitleEdit"])';
            let lbEdit='@Html.Raw(Localizer["lbEdit"])';
            let lbBtnSaveNewCategory='@Html.Raw(Localizer["lbBtnSaveNewCategory"])';
            let lbSave='@Html.Raw(Localizer["lbSave"])';
        </script>
    }