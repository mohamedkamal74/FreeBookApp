@model CategoryViewModel
@inject UserManager<Infrastructure.ViewModel.ApplicationUser> usermanager
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "Caregories";
}

<style>
    /* Style the tab */
    .tab {
        overflow: hidden;
        border: 1px solid #ccc;
        background-color: #f1f1f1;
    }

        /* Style the buttons that are used to open the tab content */
        .tab button {
            background-color: inherit;
            float: right;
            border: none;
            outline: none;
            cursor: pointer;
            padding: 14px 16px;
            transition: 0.3s;
        }

            /* Change background color of buttons on hover */
            .tab button:hover {
                background-color: #ddd;
            }

            /* Create an active/current tablink class */
            .tab button.active {
                background-color: #ccc;
            }

    /* Style the tab content */
    .tabcontent {
        display: none;
        padding: 6px 12px;
        border: 1px solid #ccc;
        border-top: none;
    }

</style>

<div class="content-wrapper">
    <!--Content Header-->

    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbCategories"] </h1>
                </div>
                <div class="col-sm-6">
                    <ol class=" breadcrumb float-sm-right">
<li class="breadcrumb-item"><a href="/Admin/Home/Index"> @Localizer["lbHomePage"]</a></li>
<li class="breadcrumb-item active">@Localizer["lbManageBook"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--End content Header-->
   
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-start">
            <h3 class="card-title">@Localizer["lbCategories"]</h3>
        </div>
        <div class="card-tools">
            <!-- Button trigger modal -->

            <button type="button" class="btn btn-outline-primary rounded-pill mr-5 mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                @Localizer["lbBtnSaveNewCategory"]
            </button>
            <!-- Button trigger modal -->
        </div>
        <!-- /.card-header -->
        <div class="card-body">

            <!-- Tab links -->
            <div class="tab">
                <button class="tablinks" onclick="openCity(event, 'Categories')" id="defaultOpen">@Localizer["lbCategories"]</button>
                <button class="tablinks" onclick="openCity(event, 'LogCategories')">@Localizer["lbLogCategories"]</button>

            </div>

             <!-- Tab content -->
            <div id="Categories" class="tabcontent">
                <table id="tableCategories" class="table table-bordered table-hover table-striped">
<thead>
    <tr>
        <td>@Localizer["lbNameCategory"]</td>
        <td>@Localizer["lbDescription"]</td>
        <td>@Localizer["lbEvents"]</td>
    </tr>
</thead>
                    <tbody>
                        @foreach (var item in Model.Categories)
                        {
                            <tr>
                                <td>
                                    @item.Name
                                </td>
                                <td>@item.Description</td>
<td>
    <input type="button" class="btn btn-info btn-sm" onclick="Edit('@item.Id','@item.Name','@item.Description')" value="@Localizer["lbBtnEdit"]" data-bs-toggle="modal" data-bs-target="#exampleModal" />
    <input type="button" class="btn btn-danger btn-sm" onclick="Delete('@item.Id')" value="@Localizer["lbbtnDelete"]" />
</td>
                            </tr>

                        }

                    </tbody>


                </table>
            </div>


             <div id="LogCategories" class="tabcontent">
                <table id="tableLogCategories" class="table table-bordered table-hover table-striped">
<thead>
    <tr>
        <td>@Localizer["lbNameCategory"]</td>
        <td>@Localizer["lbActionName"]</td>
        <td>@Localizer["lbDate"]</td>
        <td>@Localizer["lbUserName"]</td>
        <td>@Localizer["lbEvents"]</td>
    </tr>
</thead>
                    <tbody>
                        @foreach (var item in Model.LogCategories)
                        {
                            <tr>
                                <td>
                                    @item.category?.Name
                                </td>
                                <td>
                                    @switch (@item.Action)
                                    {
                                        case "Save":
                                            <span class="badge badge-success" style="width:150px;height:25px">@item.Action</span>
                                            break;
                                        case "Update":
                                            <span class="badge badge-warning" style="width:150px;height:25px">@item.Action</span>
                                            break;
                                        default:
                                            <span class="badge badge-danger" style="width:150px;height:25px">@item.Action</span>
                                            break;
                                    }
                                </td>
                                <td>@item.Date</td>
                                <td>@usermanager.FindByIdAsync(item.UserId.ToString()).Result?.Name</td>
                                <td>

                                    <input type="button" class="btn btn-danger btn-sm" onclick="DeleteLog('@item.Id')" value="@Localizer["lbbtnDelete"]" />
                                </td>
                            </tr>

                        }

                    </tbody>




                </table>
            </div>

             <!-- /.card-body -->
        </div>
    </div>


     <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="title">@Localizer["lbBtnSaveNewCategory"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                    <form asp-action="Save" asp-controller="Categories" method="post">
                        <input type="text" asp-for="NewCategory.Id" hidden class="form-control" id="categoryId" />

<div class="form-group">
    <label class="control-label" asp-for="NewCategory.Name">@Localizer["lbNameCategory"]</label>
    <input type="text" asp-for="NewCategory.Name" class="form-control" id="categoryName" />
</div>

<div class="form-group">
    <label class="control-label" asp-for="NewCategory.Description">@Localizer["lbDescription"]</label>
    <input type="text" asp-for="NewCategory.Description" class="form-control" id="description" />
    <span asp-validation-for="NewCategory.Description" class="text-danger"></span>
</div>

<div class="modal-footer-rtl" style="padding:0 15px 15px 0">
    <input type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="btnSave" />
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<form id="deleteForm" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" id="deleteFormId" />
</form>

@section Script{
@if(!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
{
    if(Context.Session.GetString(Helper.MsgType)==Helper.Success)
    {
<script>
            Swal.fire({

      icon: 'success',
      title:'@Context.Session.GetString(Helper.Title)',
      text:' @Html.Raw(Context.Session.GetString(Helper.Msg))',
       confirmButtonText:'@Localizer["lbOk"]'


    })
</script>
    }
    else{
<script>
                Swal.fire({
      icon: 'error',
      title: '@Context.Session.GetString(Helper.Title)',
      text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
      confirmButtonText:'@Localizer["lbOk"]'


    })
</script>
    }
Context.Session.SetString("msgType","");
}

<script src="~/Models/Categories.js"></script>

<script>

    let lbTitleEditCategory='@Html.Raw(Localizer["lbTitleEditCategory"])';
    let lbEdit='@Html.Raw(Localizer["lbEdit"])';
    let lbBtnSaveNewCategory='@Html.Raw(Localizer["lbBtnSaveNewCategory"])';
    let lbSave='@Html.Raw(Localizer["lbSave"])';

    let lbBtnSave = '@Html.Raw(Localizer["lbBtnSave"])';
    let lbTextMsgDelete = '@Html.Raw(Localizer["lbTextMsgDelete"])';
    let lbconfirmButtonText = '@Html.Raw(Localizer["lbconfirmButtonText"])';
    let lbcancelButtonText = '@Html.Raw(Localizer["lbCancelButtonText"])';
    let lbTitleDeletedOk = '@Html.Raw(Localizer["lbTitleDeletedOk"])';
    let lbMsgDeletedOkCategory = '@Html.Raw(Localizer["lbMsgDeletedOkCategory"])';

   let lbSuccess = '@Html.Raw(Helper.Success)';
</script>


}