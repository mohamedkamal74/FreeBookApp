@model GovernorateViewModel
@inject IStringLocalizer<ResourceWeb> Localizer

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbGovernorates"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Dashboard/Index"> @Localizer["lbHomePage"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbManageBook"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-start">
            <h3 class="card-title">@Localizer["lbGovernorates"]</h3>
        </div>
        <div class="card-tools">
            <button type="button" class="btn btn-outline-primary rounded-pill mr-5 mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                @Localizer["lbBtnSaveNewGovernorate"]
            </button>
        </div>
        <div class="card-body">
            <table id="tableGovernorates" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbGovernorateName"]</th>
                        <th scope="col">@Localizer["lbAreasCount"]</th>
                        <th scope="col">@Localizer["lbEvents"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Governorates)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Areas.Count</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-info" onclick="Edit('@item.Id','@Js.Encode(item.Name)')"
                                            title="@Localizer["lbBtnEdit"]" aria-label="@Localizer["lbBtnEdit"]"
                                            data-bs-toggle="modal" data-bs-target="#exampleModal">
                                        <i class="fas fa-edit" aria-hidden="true"></i>
                                    </button>
                                    <button type="button" class="btn btn-danger" onclick="DeleteGovernorate('@item.Id')"
                                            title="@Localizer["lbbtnDelete"]" aria-label="@Localizer["lbbtnDelete"]">
                                        <i class="fas fa-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <modal id="exampleModal" title-id="governorateModalTitle" title="@Localizer["lbBtnSaveNewGovernorate"]">
        <form asp-action="Save" asp-controller="Governorates" method="post">
            <div class="form-group">
                <input type="text" asp-for="NewGovernorate.GovernorateId" hidden class="form-control" id="governorateId"/>
                <label class="control-label" asp-for="NewGovernorate.Name">@Localizer["lbGovernorateName"]</label>
                <input type="text" asp-for="NewGovernorate.Name" class="form-control" id="governorateName"/>
                <span asp-validation-for="NewGovernorate.Name" class="text-danger"></span>
            </div>
            <input type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="governorateModalBtnSave"/>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["lbClose"]</button>
        </form>
    </modal>

    <form id="deleteForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" id="deleteFormId" />
    </form>

    @section Script{
        <script src="~/Models/Governorates.js"></script>

        <script>
            let lbTitleEditGovernorate='@Html.Raw(Localizer["lbTitleEditGovernorate"])';
            let lbBtnSaveNewGovernorate='@Html.Raw(Localizer["lbBtnSaveNewGovernorate"])';
        
</script>
    }