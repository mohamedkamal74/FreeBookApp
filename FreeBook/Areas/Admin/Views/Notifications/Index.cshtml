@model List<Notification>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    string TypeLabel(Notification n) => n.Type switch
    {
        NotificationType.SubscriptionExpiring => Localizer["lbNotificationTypeExpiring"].Value,
        NotificationType.RentalOverdue => Localizer["lbNotificationTypeOverdue"].Value,
        NotificationType.FineApplied => Localizer["lbNotificationTypeFine"].Value,
        _ => string.Empty
    };

    string TypeIcon(Notification n) => n.Type switch
    {
        NotificationType.SubscriptionExpiring => "fas fa-clock",
        NotificationType.RentalOverdue => "fas fa-book",
        NotificationType.FineApplied => "fas fa-receipt",
        _ => "fas fa-bell"
    };

    string TypeBadge(Notification n) => n.Type switch
    {
        NotificationType.SubscriptionExpiring => "badge-primary",
        NotificationType.RentalOverdue => "badge-warning",
        NotificationType.FineApplied => "badge-danger",
        _ => "badge-secondary"
    };

    string MessageFor(Notification n)
    {
        var amount = n.Amount.HasValue ? $"{n.Amount.Value:F2} USD" : string.Empty;
        return n.Type switch
        {
            NotificationType.SubscriptionExpiring =>
                Localizer["lbNotificationSubscriptionExpiring", n.SubscriberName, n.Days ?? 0].Value,
            NotificationType.RentalOverdue =>
                Localizer["lbNotificationRentalOverdue", n.SubscriberName, n.BookTitle ?? "-", n.Days ?? 0].Value,
            NotificationType.FineApplied =>
                Localizer["lbNotificationFineApplied", n.SubscriberName, n.BookTitle ?? "-", n.Days ?? 0, amount].Value,
            _ => n.SubscriberName
        };
    }
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbNotifications"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@Localizer["lbHomePage"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbNotifications"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex flex-wrap align-items-center justify-content-between">
            <h3 class="card-title mb-2 mb-sm-0">@Localizer["lbNotifications"]</h3>
            @if (Model.Count > 0)
            {
                <div class="card-tools d-flex flex-wrap">
                    <form asp-action="MarkAllRead" method="post" class="mr-2 mb-1">
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-check-double" aria-hidden="true"></i>
                            @Localizer["lbMarkAllRead"]
                        </button>
                    </form>
                    <form asp-action="DeleteRead" method="post" class="mb-1">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash" aria-hidden="true"></i>
                            @Localizer["lbClearRead"]
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="card-body p-0">
            @if (TempData["NotificationError"] != null)
            {
                <div class="alert alert-warning m-3" role="alert">@Localizer["msgNotificationLoadError"]</div>
            }

            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="fas fa-bell fa-3x text-muted mb-3" aria-hidden="true"></i>
                    <h2 class="h5">@Localizer["lbNotificationEmpty"]</h2>
                    <p class="text-muted mb-0">@Localizer["lbNotificationEmptyHint"]</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped mb-0">
                        <thead>
                            <tr>
                                <th scope="col" style="width:140px">@Localizer["lbNotificationType"]</th>
                                <th scope="col">@Localizer["lbNotificationDetails"]</th>
                                <th scope="col" style="width:180px">@Localizer["lbNotificationDate"]</th>
                                <th scope="col" style="width:130px">@Localizer["lbEvents"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.IsRead ? "" : "table-primary")">
                                    <td>
                                        <span class="badge @TypeBadge(item)">
                                            <i class="@TypeIcon(item)" aria-hidden="true"></i>
                                            @TypeLabel(item)
                                        </span>
                                    </td>
                                    <td>
                                        @MessageFor(item)
                                        @if (!item.IsRead)
                                        {
                                            <span class="badge badge-info ml-1">@Localizer["lbNotificationUnread"]</span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.TargetUrl))
                                        {
                                            <a href="@item.TargetUrl" class="d-block small mt-1">
                                                @Localizer["lbNotificationDetails"] <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                            </a>
                                        }
                                    </td>
                                    <td>@item.CreatedOn.ToString("g")</td>
                                    <td>
                                        @if (!item.IsRead)
                                        {
                                            <form asp-action="MarkRead" method="post">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                        aria-label="@Localizer["lbMarkRead"]" title="@Localizer["lbMarkRead"]">
                                                    <i class="fas fa-check" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
