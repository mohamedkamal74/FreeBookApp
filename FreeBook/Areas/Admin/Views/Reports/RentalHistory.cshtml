@model List<Rental>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "RentalHistory";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbRentalHistory"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbRentalHistory"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <form method="get" class="form-inline">
                <div class="form-group mr-2">
                    <label class="mr-2">@Localizer["lbSubscriber"]</label>
                    <select name="subscriberId" class="form-control" onchange="this.form.submit()">
                        <option value="">@Localizer["lbAllSubscribers"]</option>
                        @foreach (var sub in ViewBag.Subscribers)
                        {
                            @if (ViewBag.SelectedSubscriberId == sub.Id)
                            {
                                <option value="@sub.Id" selected>@sub.FullName</option>
                            }
                            else
                            {
                                <option value="@sub.Id">@sub.FullName</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
        <div class="card-body">
            <table id="tableRentalHistory" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>@Localizer["lbSubscriber"]</th>
                        <th>@Localizer["lbBookName"]</th>
                        <th>@Localizer["lbRentalDate"]</th>
                        <th>@Localizer["lbEndDate"]</th>
                        <th>@Localizer["lbReturnDate"]</th>
                        <th>@Localizer["lbStatus"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        foreach (var rc in rental.RentalCopies)
                        {
                            var status = rc.ReturnDate != null ? Localizer["lbReturned"] : 
                                (rc.EndDate < DateTime.UtcNow ? Localizer["lbOverdue"] : Localizer["lbActive"]);
                            var statusClass = rc.ReturnDate != null ? "badge-success" : 
                                (rc.EndDate < DateTime.UtcNow ? "badge-danger" : "badge-warning");
                            <tr>
                                <td>@rental.Subscriber?.FullName</td>
                                <td>@rc.BookCopy?.Book?.Name</td>
                                <td>@rc.RentalDate.ToString("yyyy-MM-dd")</td>
                                <td>@rc.EndDate.ToString("yyyy-MM-dd")</td>
                                <td>@(rc.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td><span class="badge @statusClass">@status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                $("#tableRentalHistory").DataTable({
                    "responsive": true,
                    "lengthChange": false,
                    "autoWidth": false,
                    "buttons": ["copy", "csv", "excel", "pdf", "print"]
                }).buttons().container().appendTo('#tableRentalHistory_wrapper .col-md-6:eq(0)');
            });
        </script>
    }