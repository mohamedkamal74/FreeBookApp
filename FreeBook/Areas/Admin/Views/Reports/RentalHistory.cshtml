@model RentalHistoryData
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbRentalHistory"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbRentalHistory"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <form method="get" class="form-inline">
                <div class="form-group mr-2">
                    <label class="mr-2">@Localizer["lbSubscriber"]</label>
                    <select name="subscriberId" class="form-control" onchange="this.form.submit()">
                        <option value="">@Localizer["lbAllSubscribers"]</option>
                        @foreach (var sub in Model.Subscribers)
                        {
                            @if (Model.SelectedSubscriberId == sub.Id)
                            {
                                <option value="@sub.Id" selected>@sub.Name</option>
                            }
                            else
                            {
                                <option value="@sub.Id">@sub.Name</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
        <div class="card-body">
            <table id="tableRentalHistory" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbSubscriber"]</th>
                        <th scope="col">@Localizer["lbBookName"]</th>
                        <th scope="col">@Localizer["lbRentalDate"]</th>
                        <th scope="col">@Localizer["lbEndDate"]</th>
                        <th scope="col">@Localizer["lbReturnDate"]</th>
                        <th scope="col">@Localizer["lbStatus"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model.Rentals)
                    {
                        var status = rental.ReturnDate != null ? Localizer["lbReturned"] :
                            (rental.EndDate < DateTime.UtcNow ? Localizer["lbOverdue"] : Localizer["lbActive"]);
                        var statusClass = rental.ReturnDate != null ? "badge-success" :
                            (rental.EndDate < DateTime.UtcNow ? "badge-danger" : "badge-warning");
                        <tr>
                            <td>@rental.SubscriberName</td>
                            <td>@rental.BookName</td>
                            <td>@rental.RentalDate.ToString("yyyy-MM-dd")</td>
                            <td>@rental.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@(rental.ReturnDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td><span class="badge @statusClass">@status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                initReportTable('#tableRentalHistory');
            });
        </script>
    }
