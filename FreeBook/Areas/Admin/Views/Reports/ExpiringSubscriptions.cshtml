@model ExpiringSubscriptionsData
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbExpiringSubscriptions"] (@Model.Days @Localizer["lbDays"])</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbExpiringSubscriptions"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tableExpiring" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbSubscriber"]</th>
                        <th scope="col">@Localizer["lbNationalId"]</th>
                        <th scope="col">@Localizer["lbMobileNumber"]</th>
                        <th scope="col">@Localizer["lbEmail"]</th>
                        <th scope="col">@Localizer["lbStartDate"]</th>
                        <th scope="col">@Localizer["lbEndDate"]</th>
                        <th scope="col">@Localizer["lbDaysLeft"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model.Subscriptions)
                    {
                        var daysLeft = (sub.EndDate - DateTime.UtcNow).Days;
                        <tr class="@(daysLeft <= 7 ? "table-danger" : (daysLeft <= 14 ? "table-warning" : ""))">
                            <td>@sub.Subscriber?.FullName</td>
                            <td>@sub.Subscriber?.NationalId</td>
                            <td>@sub.Subscriber?.MobileNumber</td>
                            <td>@sub.Subscriber?.Email</td>
                            <td>@sub.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@sub.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@daysLeft @Localizer["lbDays"]</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                initReportTable('#tableExpiring');
            });
        </script>
    }