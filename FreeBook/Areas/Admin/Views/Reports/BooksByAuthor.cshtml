@model List<FreeBook.Models.BooksByAuthorReport>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbBooksByAuthor"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbBooksByAuthor"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tableByAuthor" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbAuthor"]</th>
                        <th scope="col">@Localizer["lbBookCount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Author?.Name</td>
                            <td>@item.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                initReportTable('#tableByAuthor');
            });
        </script>
    }