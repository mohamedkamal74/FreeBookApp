@model List<Subscriber>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "ActiveSubscribers";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbActiveSubscribers"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbActiveSubscribers"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tableActiveSubs" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>@Localizer["lbSubscriber"]</th>
                        <th>@Localizer["lbNationalId"]</th>
                        <th>@Localizer["lbMobileNumber"]</th>
                        <th>@Localizer["lbEmail"]</th>
                        <th>@Localizer["lbArea"]</th>
                        <th>@Localizer["lbGovernorate"]</th>
                        <th>@Localizer["lbSubscriptionEnd"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var subscriber in Model)
                    {
                        var activeSub = subscriber.Subscriptions.FirstOrDefault(s => s.StartDate <= DateTime.UtcNow && s.EndDate >= DateTime.UtcNow);
                        <tr>
                            <td>@subscriber.FullName</td>
                            <td>@subscriber.NationalId</td>
                            <td>@subscriber.MobileNumber</td>
                            <td>@subscriber.Email</td>
                            <td>@subscriber.Area?.Name</td>
                            <td>@subscriber.Governorate?.Name</td>
                            <td>@(activeSub?.EndDate.ToString("yyyy-MM-dd") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                $("#tableActiveSubs").DataTable({
                    "responsive": true,
                    "lengthChange": false,
                    "autoWidth": false,
                    "buttons": ["copy", "csv", "excel", "pdf", "print"]
                }).buttons().container().appendTo('#tableActiveSubs_wrapper .col-md-6:eq(0)');
            });
        </script>
    }