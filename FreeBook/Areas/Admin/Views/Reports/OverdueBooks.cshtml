@model List<Rental>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "OverdueBooks";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbOverdueBooks"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbOverdueBooks"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tableOverdue" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>@Localizer["lbSubscriber"]</th>
                        <th>@Localizer["lbBookName"]</th>
                        <th>@Localizer["lbRentalDate"]</th>
                        <th>@Localizer["lbEndDate"]</th>
                        <th>@Localizer["lbDaysOverdue"]</th>
                        <th>@Localizer["lbPenaltyPaid"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        foreach (var rc in rental.RentalCopies.Where(c => c.ReturnDate == null && c.EndDate < DateTime.UtcNow))
                        {
                            var daysOverdue = (DateTime.UtcNow - rc.EndDate).Days;
                            <tr class="table-danger">
                                <td>@rental.Subscriber?.FullName</td>
                                <td>@rc.BookCopy?.Book?.Name</td>
                                <td>@rc.RentalDate.ToString("yyyy-MM-dd")</td>
                                <td>@rc.EndDate.ToString("yyyy-MM-dd")</td>
                                <td>@daysOverdue @Localizer["lbDays"]</td>
                                <td>
                                    <input type="checkbox" disabled checked="@rental.PenaltyPaid" />
                                    @(rental.PenaltyPaid ? Localizer["lbPaid"] : Localizer["lbPending"])
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                $("#tableOverdue").DataTable({
                    "responsive": true,
                    "lengthChange": false,
                    "autoWidth": false,
                    "buttons": ["copy", "csv", "excel", "pdf", "print"]
                }).buttons().container().appendTo('#tableOverdue_wrapper .col-md-6:eq(0)');
            });
        </script>
    }