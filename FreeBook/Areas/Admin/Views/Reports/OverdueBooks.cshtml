@model List<OverdueBookReport>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbOverdueBooks"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbOverdueBooks"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tableOverdue" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbSubscriber"]</th>
                        <th scope="col">@Localizer["lbBookName"]</th>
                        <th scope="col">@Localizer["lbRentalDate"]</th>
                        <th scope="col">@Localizer["lbEndDate"]</th>
                        <th scope="col">@Localizer["lbDaysOverdue"]</th>
                        <th scope="col">@Localizer["lbPenaltyPaid"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rental in Model)
                    {
                        var daysOverdue = (DateTime.UtcNow - rental.EndDate).Days;
                        <tr class="table-danger">
                            <td>@rental.SubscriberName</td>
                            <td>@rental.BookName</td>
                            <td>@rental.RentalDate.ToString("yyyy-MM-dd")</td>
                            <td>@rental.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@daysOverdue @Localizer["lbDays"]</td>
                            <td>
                                <input type="checkbox" disabled checked="@rental.PenaltyPaid" />
                                @(rental.PenaltyPaid ? Localizer["lbPaid"] : Localizer["lbPending"])
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                initReportTable('#tableOverdue');
            });
        </script>
    }
