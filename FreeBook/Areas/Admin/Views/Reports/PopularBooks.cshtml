@model List<FreeBook.Models.PopularBookReport>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "PopularBooks";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbPopularBooks"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbPopularBooks"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tablePopular" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>@Localizer["lbRank"]</th>
                        <th>@Localizer["lbBookName"]</th>
                        <th>@Localizer["lbAuthor"]</th>
                        <th>@Localizer["lbCategory"]</th>
                        <th>@Localizer["lbRentalCount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@rank</td>
                                <td>@item.Book?.Name</td>
                                <td>@item.Book?.Author?.Name</td>
                                <td>@item.Book?.Category?.Name</td>
                                <td>@item.RentalCount</td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                $("#tablePopular").DataTable({
                    "responsive": true,
                    "lengthChange": false,
                    "autoWidth": false,
                    "buttons": ["copy", "csv", "excel", "pdf", "print"]
                }).buttons().container().appendTo('#tablePopular_wrapper .col-md-6:eq(0)');
            });
        </script>
    }