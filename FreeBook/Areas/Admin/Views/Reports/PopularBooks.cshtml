@model List<PopularBookReport>
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="content-wrapper">
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbPopularBooks"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Reports">@Localizer["lbReports"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbPopularBooks"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table id="tablePopular" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["lbRank"]</th>
                        <th scope="col">@Localizer["lbBookName"]</th>
                        <th scope="col">@Localizer["lbAuthor"]</th>
                        <th scope="col">@Localizer["lbCategory"]</th>
                        <th scope="col">@Localizer["lbRentalCount"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rank = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@rank</td>
                                <td>@item.BookName</td>
                                <td>@item.AuthorName</td>
                                <td>@item.CategoryName</td>
                                <td>@item.RentalCount</td>
                            </tr>
                            rank++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @section Script{
        <script>
            $(function () {
                initReportTable('#tablePopular');
            });
        </script>
    }