@model AuthorViewModel
@inject IStringLocalizer<ResourceWeb> Localizer
@{
    ViewData["Title"] = "Authors";
}

<div class="content-wrapper">
    <!--Content Header-->
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0 text-dark">@Localizer["lbAuthors"]</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Admin/Home/Index"> @Localizer["lbHomePage"]</a></li>
                        <li class="breadcrumb-item active">@Localizer["lbManageBook"]</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
    <!--End content Header-->
    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-start">
            <h3 class="card-title">@Localizer["lbAuthors"]</h3>
        </div>
        <div class="card-tools">
            <button type="button" class="btn btn-outline-primary rounded-pill mr-5 mt-2" data-bs-toggle="modal" data-bs-target="#exampleModal" onclick="Rest()">
                @Localizer["lbBtnSaveNewAuthor"]
            </button>
        </div>
        <div class="card-body">
            <table id="tableAuthors" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <td>@Localizer["lbAuthorName"]</td>
                        <td>@Localizer["lbEvents"]</td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Authors)
                    {
                        <tr>
                            <td>
                                @item.Name
                            </td>
                            <td>
                                <input type="button" class="btn btn-info btn-sm" onclick="Edit('@item.Id','@Js.Encode(item.Name)')" value="@Localizer["lbBtnEdit"]" data-bs-toggle="modal" data-bs-target="#exampleModal" />
                                <input type="button" class="btn btn-danger btn-sm" onclick="DeleteAuthor('@item.Id')" value="@Localizer["lbbtnDelete"]" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="authorModalTitle">@Localizer["lbBtnSaveNewAuthor"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form asp-action="Save" asp-controller="Authors" method="post">
                        <div class="form-group">
                            <input type="text" asp-for="NewAuthor.AuthorId" hidden class="form-control" id="authorId"/>
                            <label class="control-label" asp-for="NewAuthor.Name">@Localizer["lbAuthorName"]</label>
                            <input type="text" asp-for="NewAuthor.Name" class="form-control" id="authorName"/>
                            <span asp-validation-for="NewAuthor.Name" class="text-danger"></span>
                        </div>
                        <input type="submit" class="btn btn-success" value="@Localizer["lbBtnSave"]" id="authorModalBtnSave"/>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </form>
                </div>
                <div class="modal-footer">
                </div>
            </div>
        </div>
    </div>

    <form id="deleteForm" method="post" class="d-none">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" id="deleteFormId" />
    </form>

    @section Script{
        @if(!string.IsNullOrEmpty(Context.Session.GetString(Helper.MsgType)))
        {
            if(Context.Session.GetString(Helper.MsgType)==Helper.Success)
            {
                <script>
                Swal.fire({
                    icon: 'success',
                    title:'@Context.Session.GetString(Helper.Title)',
                    text:' @Html.Raw(Context.Session.GetString(Helper.Msg))',
                    confirmButtonText:'@Localizer["lbOk"]'
                })
                </script>
            }
            else{
                <script>
                    Swal.fire({
                        icon: 'error',
                        title: '@Context.Session.GetString(Helper.Title)',
                        text: '@Html.Raw(Context.Session.GetString(Helper.Msg))',
                        confirmButtonText:'@Localizer["lbOk"]'
                    })
                </script>
            }
            Context.Session.SetString("msgType","");
        }

        <script src="~/Models/Authors.js"></script>

        <script>
            let lbTitleEditAuthor='@Html.Raw(Localizer["lbTitleEditAuthor"])';
            let lbEdit='@Html.Raw(Localizer["lbEdit"])';
            let lbBtnSaveNewAuthor='@Html.Raw(Localizer["lbBtnSaveNewAuthor"])';
            let lbSave='@Html.Raw(Localizer["lbSave"])';
            let lbTitleDeleteMsg='@Html.Raw(Localizer["lbTitleDeleteMsg"])';
            let lmTextMsgDelete='@Html.Raw(Localizer["lmTextMsgDelete"])';
            let lbconfirmButtonText='@Html.Raw(Localizer["lbconfirmButtonText"])';
            let lbCancelButtonText='@Html.Raw(Localizer["lbCancelButtonText"])';
        </script>
    }