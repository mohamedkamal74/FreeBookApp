@inject IStringLocalizer<ResourceWeb> Localizer

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-body text-center py-5">
                <div class="error-code" aria-hidden="true">403</div>
                <h1 class="h4 mt-3 mb-4">@Localizer["lbMsgDenied"]</h1>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-home" aria-hidden="true"></i>
                    @Localizer["lbGoToDashboard"]
                </a>
            </div>
        </div>
    </div>
</div>
